#include <stdio.h>

int main() {
    char name[100];
    int age;

    printf("Enter your full name: ");
    fgets(name, sizeof(name), stdin);   // reads full name with spaces

    printf("Enter your age: ");
    scanf("%d", &age);

    printf("Hello %s, you are %d years old.\n", name, age);

    return 0;
}
