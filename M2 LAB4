#include <stdio.h>
 int main() {
    char first[50], last[50], full[100];
    int i = 0, j = 0, k = 0;
    printf("Enter first name: ");
    scanf("%s", first);
    printf("Enter last name: ");
    scanf("%s", last);
    while (first[i] != '\0') {
        full[k++] = first[i++];
    }
    full[k++] = '\0';
    while (last[j] != '\0') {
        full[k++] = last[j++];
    }
    full[k] = '\0'; 
    printf("\nFull Name: %s\n", full);
    printf("Length: %d\n", k);
} 
