#include <stdio.h>
struct Book {
    char title[20];
    char author[20];
    int year;
};
int main() {
    struct Book b;
    printf("Enter title: ");
    scanf("%s", b.title);
    printf("Enter author: ");
    scanf("%s", b.author);
    printf("Enter year: ");
    scanf("%d", &b.year);
    printf("\nBook Details:\n");
    printf("%s\n", b.title);
    printf("%s\n", b.author);
    printf("%d\n", b.year);
}
